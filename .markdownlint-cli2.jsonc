{
  "config": {
    // Все остальные правила включены.
    "default": true,



    // Заголовки: #, ##, ###.
    "MD003": {
      "style": "atx"
    },



    // Маркеры ненумерованных списков: дефис.
    "MD004": {
      "style": "dash"
    },



    // Отступ вложенных списков: 2 пробела.
    "MD007": {
      "indent": 2
    },



    // Не больше одной пустой строки подряд.
    "MD012": {
      "maximum": 1
    },



    // Длинные ссылки и таблицы не ограничиваем по длине.
    "MD013": false,



    // Одинаковые заголовки допустимы в разных разделах.
    "MD024": {
      "siblings_only": true
    },



    // Один H1 в Markdown; title в YAML не считаем H1.
    "MD025": {
      "level": 1,
      "front_matter_title": ""
    },



    // HTML нужен для карточек, блоков и разметки Jekyll.
    "MD033": false,



    // Главная страница может начинаться с HTML.
    "MD041": false,



    // Перевод строки в конце файла обязателен.
    "MD047": true,



    // Таблицы и списки отделяем пустыми строками.
    "MD032": true,
    "MD058": true,



    // Табличный стиль не проверяем: Jekyll/Markdown таблицы могут быть compact или aligned.
    "MD060": false,



    // Временно отключено из-за Liquid-фильтров в таблицах.
    "MD056": false
  },



  "globs": [
    "**/*.md"
  ],



  "ignores": [
    "**/node_modules/**",
    "_site/**",
    ".jekyll-cache/**",
    ".jekyll-metadata",
    "vendor/**",
    ".git/**",
    "**/.aider*"
  ]
}