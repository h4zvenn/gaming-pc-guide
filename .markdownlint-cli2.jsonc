{
  "config": {
    // Все правила включены по умолчанию.
    "default": true,

    // Заголовки: #, ##, ###.
    "MD003": { "style": "atx" },

    // Маркеры ненумерованных списков: дефис.
    "MD004": { "style": "dash" },

    // Отступ вложенных списков: 2 пробела.
    "MD007": { "indent": 2 },

    // Не больше одной пустой строки подряд.
    "MD012": { "maximum": 1 },

    // Длину строк не ограничиваем.
    "MD013": false,

    // Одинаковые заголовки допустимы в разных разделах.
    "MD024": { "siblings_only": true },

    // Один H1 на файл; title из front matter не считается.
    "MD025": { "level": 1, "front_matter_title": "" },

    // HTML разрешён (details, summary, Jekyll-разметка).
    "MD033": false,

    // Первая строка может быть не заголовком.
    "MD041": false,

    // Перевод строки в конце файла обязателен.
    "MD047": true,

    // Списки и таблицы отделяем пустыми строками.
    "MD032": true,
    "MD058": true,

    // Стиль таблиц не проверяем.
    "MD060": false,

    // Отключено из-за Liquid-фильтров в таблицах.
    "MD056": false
  },

  "globs": ["**/*.md"],

  "ignores": [
    "**/node_modules/**",
    "_site/**",
    ".jekyll-cache/**",
    "vendor/**",
    ".git/**",
    "**/.aider*"
  ]
}
